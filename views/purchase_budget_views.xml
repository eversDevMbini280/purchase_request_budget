<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="purchase_budget_view_form" model="ir.ui.view">
        <field name="name">purchase.budget.form</field>
        <field name="model">purchase.budget</field>
        <field name="arch" type="xml">
            <form string="Budget de département">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="department_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                    </group>
                    <group>
                        <field name="amount"/>
                        <field name="committed"/>
                        <field name="remaining"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="purchase_budget_view_list" model="ir.ui.view">
        <field name="name">purchase.budget.list</field>
        <field name="model">purchase.budget</field>
        <field name="arch" type="xml">
            <list string="Budgets">
                <field name="department_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="amount"/>
                <field name="committed"/>
                <field name="remaining"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="purchase_budget_action" model="ir.actions.act_window">
        <field name="name">Budgets</field>
        <field name="res_model">purchase.budget</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="purchase_request_menu_budgets"
              name="Budgets"
              parent="purchase_request_menu_root"
              action="purchase_budget_action"
              sequence="30"/>

</odoo>
