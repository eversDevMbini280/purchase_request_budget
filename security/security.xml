<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Catégorie pour ranger les groupes dans l'interface utilisateur -->
    <record id="module_category_purchase_request" model="ir.module.category">
        <field name="name">Demandes d'achat</field>
        <field name="sequence">10</field>
    </record>

    <!-- Groupe 1 : Demandeur -->
    <record id="group_request_user" model="res.groups">
        <field name="name">Demandeur</field>
        <field name="category_id" ref="module_category_purchase_request"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Groupe 2 : Manager (implique Demandeur) -->
    <record id="group_request_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_purchase_request"/>
        <field name="implied_ids" eval="[(4, ref('group_request_user'))]"/>
    </record>

    <!-- Groupe 3 : Direction (implique Manager) + Ajout de l'administrateur -->
    <record id="group_request_direction" model="res.groups">
        <field name="name">Direction</field>
        <field name="category_id" ref="module_category_purchase_request"/>
        <field name="implied_ids" eval="[(4, ref('group_request_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
