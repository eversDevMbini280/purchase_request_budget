<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_request_refuse_wizard_form" model="ir.ui.view">
        <field name="name">purchase.request.refuse.wizard.form</field>
        <field name="model">purchase.request.refuse.wizard</field>
        <field name="arch" type="xml">
            <form string="Refuser la demande">
                <group>
                    <field name="request_id" readonly="1" force_save="1"/>
                    <field name="reason" placeholder="Expliquez pourquoi la demande est refusée..."/>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirmer le refus"
                            type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Annuler" class="btn-secondary"
                            special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
